APP_NAME="Climatisation Maroc"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public site URL (nginx). Used for absolute URLs, e-mails and storage links.
APP_URL=http://localhost:8080
# Next.js front office base URL (links in e-mails, revalidation callbacks).
FRONTEND_URL=http://localhost:8080
FRONTEND_INTERNAL_URL=http://next:3000
REVALIDATE_SECRET=change-me

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Casablanca

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=climatisation
DB_USERNAME=climatisation
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# "public" = local disk served at /storage. Set to "s3" (and the AWS_* values) to move uploads to S3.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=cm_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ecom@arihafroid.com"
MAIL_FROM_NAME="${APP_NAME}"
# Shop inbox for new orders and leads.
SHOP_NOTIFICATION_EMAIL=ecom@arihafroid.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Seeded back-office accounts (development and first install only).
SEED_ADMIN_EMAIL=admin@climatisationmaroc.test
SEED_ADMIN_PASSWORD=change-me-admin
SEED_MANAGER_EMAIL=gestionnaire@climatisationmaroc.test
SEED_MANAGER_PASSWORD=change-me-manager
SEED_RESELLER_PASSWORD=change-me-reseller
