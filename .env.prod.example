# Production environment for docker-compose.prod.yml. Copy to .env.prod and fill every value.
APP_NAME="Climatisation Maroc"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://climatisationmaroc.com
FRONTEND_URL=https://climatisationmaroc.com
FRONTEND_INTERNAL_URL=http://next:3000
REVALIDATE_SECRET=
APP_PORT=80
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Casablanca

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=climatisation
DB_USERNAME=climatisation
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
CACHE_PREFIX=cm_
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=public
# For S3: FILESYSTEM_DISK=s3 and the AWS_* values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=ecom@arihafroid.com
MAIL_FROM_NAME="Climatisation Maroc"
SHOP_NOTIFICATION_EMAIL=ecom@arihafroid.com

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
SEED_RESELLER_PASSWORD=
