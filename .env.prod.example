# Production environment (docker-compose.prod.yml). Copy to .env.prod and fill in; on Coolify paste
# the KEY=value lines into Environment Variables (Developer view). Never commit .env.prod.
# Values with spaces must be quoted. See docs/deployment.md.

APP_NAME=
APP_ENV=
APP_DEBUG=
# APP_KEY: generate: php artisan key:generate --show (in the php container)
APP_KEY=
# APP_URL: https://app.arfro.com
APP_URL=
APP_LOCALE=
APP_FALLBACK_LOCALE=
APP_TIMEZONE=
APP_MAINTENANCE_DRIVER=
BCRYPT_ROUNDS=
# APP_PORT: host port for make prod-up only (not used on Coolify)
APP_PORT=
# APP_SEED: auto = seed an empty database on first start
APP_SEED=

# NEXT_PUBLIC_SITE_URL: https://app.arfro.com (baked into the Next.js build)
NEXT_PUBLIC_SITE_URL=
# FRONTEND_URL: https://app.arfro.com
FRONTEND_URL=
FRONTEND_INTERNAL_URL=
# REVALIDATE_SECRET: random, 32+ characters (openssl rand -base64 32)
REVALIDATE_SECRET=

LOG_CHANNEL=
LOG_LEVEL=
LOG_DEPRECATIONS_CHANNEL=

DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
# DB_PASSWORD: random
DB_PASSWORD=
# DB_ROOT_PASSWORD: random, different from DB_PASSWORD
DB_ROOT_PASSWORD=

SESSION_DRIVER=
SESSION_LIFETIME=
SESSION_ENCRYPT=
SESSION_PATH=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
CACHE_STORE=
CACHE_PREFIX=
QUEUE_CONNECTION=
REDIS_CLIENT=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
BROADCAST_CONNECTION=
SANCTUM_EXPIRATION=
# TRUSTED_PROXIES: optional: TLS terminator outside the Docker network (empty = Docker private ranges)
TRUSTED_PROXIES=

FILESYSTEM_DISK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=

MAIL_MAILER=
MAIL_SCHEME=
# MAIL_HOST: SMTP server of the shop
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM_ADDRESS: sender address of the SMTP account
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
SHOP_NOTIFICATION_EMAIL=

# SEED_ADMIN_EMAIL: required: back-office administrator login
SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD: required: 12+ characters, not starting with change-me
SEED_ADMIN_PASSWORD=
# SEED_MANAGER_EMAIL: required: manager login
SEED_MANAGER_EMAIL=
# SEED_MANAGER_PASSWORD: required: 12+ characters
SEED_MANAGER_PASSWORD=

BACKUP_ENABLED=
BACKUP_KEEP=
BACKUP_AT=

PHP_MEMORY=
QUEUE_MEMORY=
SCHEDULER_MEMORY=
NGINX_MEMORY=
NEXT_MEMORY=
MYSQL_MEMORY=
REDIS_MEMORY=
