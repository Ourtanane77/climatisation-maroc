# Production environment for docker-compose.prod.yml (php, queue, scheduler, mysql read it;
# compose also uses it for ${…} substitution: pass `--env-file .env.prod`, as the Makefile does).
# Copy to .env.prod, fill every value marked CHANGE, never commit .env.prod.
# Generate secrets with:  openssl rand -base64 32   (APP_KEY: see below)

# --- Application -------------------------------------------------------------------------------
APP_NAME="Climatisation Maroc"
APP_ENV=production
APP_DEBUG=false
# CHANGE: `docker run --rm climatisation-maroc/php:prod php artisan key:generate --show` after `make prod-build`.
APP_KEY=
# Public HTTPS address of the site (absolute URLs, e-mails, storage links).
APP_URL=https://app.arfro.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Casablanca
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# Host port nginx listens on; the TLS terminator proxies to it (keep it private: firewall or 127.0.0.1).
APP_PORT=80
# First deploy seeds the empty database (categories, catalogue, content, settings, staff accounts)
# and downloads the catalogue images; later deploys never reseed. Set to "false" to disable.
APP_SEED=auto

# --- Front office (Next.js) ----------------------------------------------------------------------
# Public site URL baked into the Next build (canonical URLs, sitemap, Open Graph). Same as APP_URL.
NEXT_PUBLIC_SITE_URL=https://app.arfro.com
FRONTEND_URL=https://app.arfro.com
# Internal address Laravel calls to refresh the front office cache (docker network).
FRONTEND_INTERNAL_URL=http://next:3000
# CHANGE: shared secret between Laravel and Next (/api/revalidate). Random, 32+ characters.
REVALIDATE_SECRET=

# --- Logs ----------------------------------------------------------------------------------------
# stderr: read with `make prod-logs` (Docker rotates them: 5 × 10 MB per container).
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (MySQL container) ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=climatisation
DB_USERNAME=climatisation
# CHANGE: two different strong passwords.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Sessions, cache, queue (Redis container) ----------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Cookie domain: empty = the exact host. Use .arfro.com only to share it across subdomains.
SESSION_DOMAIN=
# Back-office session cookie only over HTTPS (requires the TLS terminator).
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
CACHE_PREFIX=cm_
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
BROADCAST_CONNECTION=log
# Reseller tokens are bearer tokens sent server-side by Next: no Sanctum stateful domains to set.
# Optional: reseller login lifetime in minutes (default 43200 = 30 days).
# SANCTUM_EXPIRATION=43200

# --- Proxies ---------------------------------------------------------------------------------------
# Laravel trusts X-Forwarded-* only from private Docker networks (config/trustedproxy.php). Set this
# only when the TLS terminator runs outside the Docker network (e.g. its public/host IP, comma-separated).
# TRUSTED_PROXIES=

# --- Files ---------------------------------------------------------------------------------------
# public = Docker volume storage_public, served by nginx at /storage (private files: storage_private).
# For S3: FILESYSTEM_DISK=s3 and the AWS_* values.
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- E-mail (orders, quotes, reseller decisions, password reset) --------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
# CHANGE: SMTP account of the shop (e.g. the mail provider of arihafroid.com).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=ecom@arihafroid.com
MAIL_FROM_NAME="Climatisation Maroc"
# Shop inbox for new orders and leads.
SHOP_NOTIFICATION_EMAIL=ecom@arihafroid.com

# --- Back-office accounts created by the first seed ----------------------------------------------
# CHANGE: real e-mails and strong passwords: at least 12 characters, not starting with "change-me"
# (the production seed refuses weak staff passwords). Change them again in Utilisateurs after the first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
# Demo reseller: only seeded outside production; leave empty.
SEED_RESELLER_PASSWORD=

# --- Container memory limits (optional; defaults in docker-compose.prod.yml) ---------------------
# PHP_MEMORY=1g
# QUEUE_MEMORY=512m
# NEXT_MEMORY=1g
# MYSQL_MEMORY=1g

# Daily backup of the database and storage (php artisan app:backup, run by the scheduler).
# See docs/deployment.md « Backups »; copy BACKUP_PATH off the server.
BACKUP_ENABLED=true
BACKUP_KEEP=14
BACKUP_AT=03:15
# BACKUP_PATH=/var/www/backend/storage/app/private/backups
